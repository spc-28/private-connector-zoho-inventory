# Zoho API Console client ("Server-based application"). Never commit real values.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=

# Must match the redirect URI registered in the Zoho API Console.
ZOHO_REDIRECT_URI=http://127.0.0.1:8765/callback

# Accounts server used to start login. The data center is then discovered from the redirect.
# For a Self Client grant code, set this to your data center, e.g. https://accounts.zoho.in
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com

# Optional: overrides the organization chosen during setup.
ZOHO_ORGANIZATION_ID=

# Sales-order field that holds the Razorpay payment ID.
ZOHO_PAYMENT_LINK_FIELD=reference_number

# Seed script only: a separate Zoho Self Client with write scopes. Never used by the connector.
ZOHO_SEED_CLIENT_ID=
ZOHO_SEED_CLIENT_SECRET=
ZOHO_SEED_ACCOUNTS_URL=https://accounts.zoho.com
# Exact name of the demo organization. The script refuses any other organization.
ZOHO_SEED_ORG_NAME=

# Limiter defaults match the Zoho Free plan.
ZOHO_RATE_PER_MINUTE=100
ZOHO_MAX_CONCURRENCY=5
ZOHO_DAILY_LIMIT=1000
